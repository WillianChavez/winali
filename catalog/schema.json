{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WillianChavez/winali/main/catalog/schema.json",
  "title": "Winali catalog v1",
  "type": "object",
  "required": ["schemaVersion", "apps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "apps": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/app"}}
  },
  "$defs": {
    "https": {"type": "string", "pattern": "^https://[^/@]+/"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release": {
      "type": "object",
      "required": ["versionCode", "versionName", "minSdk", "architectures", "url", "size", "sha256", "certificateSha256", "changelog"],
      "properties": {
        "versionCode": {"type": "integer", "minimum": 1},
        "versionName": {"type": "string", "minLength": 1},
        "minSdk": {"type": "integer", "minimum": 1},
        "architectures": {"type": "array", "items": {"enum": ["universal", "arm64-v8a", "armeabi-v7a", "x86", "x86_64"]}},
        "url": {"$ref": "#/$defs/https"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "sha256": {"$ref": "#/$defs/hash"},
        "certificateSha256": {"$ref": "#/$defs/hash"},
        "changelog": {"type": "string"}
      }
    },
    "app": {
      "type": "object",
      "required": ["id", "packageName", "name", "summary", "description", "category", "repository", "screenshots", "permissions", "release"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "packageName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"},
        "screenshots": {"type": "array", "items": {"$ref": "#/$defs/https"}},
        "icon": {"allOf": [{"$ref": "#/$defs/https"}, {"pattern": "[.]png$"}]},
        "permissions": {"type": "array", "items": {"type": "string"}},
        "locales": {"type": "object", "properties": {"en": {"type": "object", "required": ["summary", "description", "category", "permissions"], "properties": {"summary": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "permissions": {"type": "array", "items": {"type": "string"}}}}}},
        "release": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/release"}]}
      }
    }
  }
}
